CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
# Peripheral + broadcaster + GATT server are required for esp_wifi_config BLE provisioning
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=y
CONFIG_BT_NIMBLE_GATT_SERVER=y
CONFIG_FREERTOS_HZ=1000
CONFIG_MBEDTLS_PSK_MODES=y
CONFIG_MBEDTLS_KEY_EXCHANGE_PSK=y
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_HEADER_FLASHSIZE_UPDATE=y
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_XTAL_FREQ_AUTO=y

# No caller sets HttpRequestOptions::skipCertValidation to false, so the Mozilla
# root CA bundle is never attached and costs ~69 KiB of flash. Re-enable this
# (here AND in every sdkconfig.<env>, which take precedence) if a send target
# ever needs real certificate verification.
# CONFIG_MBEDTLS_CERTIFICATE_BUNDLE is not set

# Allow skipping server certificate verification at runtime (for targets that
# don't need strict TLS validation, e.g. Brewer's Friend, Brewfather, etc.)
CONFIG_ESP_TLS_INSECURE=y
CONFIG_ESP_TLS_SKIP_SERVER_CERT_VERIFY=y

# FreeRTOS Timer task needs more stack for WiFi config and logging callbacks
CONFIG_FREERTOS_TIMER_TASK_STACK_DEPTH=4096
# The host stack needs to be larger to support certain WiFi Config operations
CONFIG_BT_NIMBLE_HOST_TASK_STACK_SIZE=6144

# esp_wifi_config component options
# The SoftAP captive portal (default y; WEBUI depends on it as of 0.2.3)
CONFIG_WIFI_CFG_ENABLE_SOFTAP=y
CONFIG_WIFI_CFG_ENABLE_WEBUI=y
CONFIG_WIFI_CFG_WEBUI_CUSTOM_PATH="/littlefs/wifiui"

# Network Provisioning (BLE) — wraps ESP-IDF wifi_provisioning manager.
CONFIG_WIFI_CFG_ENABLE_NETWORK_PROVISIONING=y
CONFIG_WIFI_CFG_NETWORK_PROVISIONING_BLE=y

# Required due to a bug in ESP-IDF v5.5.3 that causes Bluetooth instability under load (e.g. during WiFi provisioning).
CONFIG_BT_NIMBLE_HS_FLOW_CTRL=n
